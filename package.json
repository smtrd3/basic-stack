{
  "name": "mini-stack",
  "version": "0.0.0",
  "private": true,
  "description": "Super basic vite based fullstack template with HMR",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build --app",
    "start": "bun run build && bun --bun ./dist",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc",
    "deploy": "bun scripts/prod.js deploy",
    "prod:start": "bun scripts/prod.js start",
    "prod:stop": "bun scripts/prod.js stop",
    "prod:restart": "bun scripts/prod.js restart",
    "prod:rollback": "bun scripts/prod.js rollback",
    "prod:status": "bun scripts/prod.js status",
    "prod:logs": "bun scripts/prod.js logs",
    "prod:cleanup": "bun scripts/prod.js cleanup"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "hono": "^4.13.13",
    "mutative": "^2.0.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "use-mutative": "^2.0.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.73.0",
    "srvx": "^1.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "bun@1.4.2"
}
